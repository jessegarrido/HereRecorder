{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/HERE.API/bin/Debug/net10.0/HERE.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/HERE.API",
            "justMyCode": false,  // ← Set to false to hide some warnings
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
               // "ASPNETCORE_URLS": "http://localhost:7152"
            },
            "logging": {
                "moduleLoad": false,           // ← Hide module load messages
                "programOutput": true,
                "exceptions": true
            }
        },
    ],
}